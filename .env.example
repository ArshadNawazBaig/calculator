NEXT_PUBLIC_SITE_URL=https://finflo.org
NEXT_PUBLIC_CONTACT_EMAIL=erushbaig@gmail.com
MAINTENANCE_MODE=false
NEXT_PUBLIC_INDEXABLE=false

# Optional public verification values from the actual webmaster accounts.
# Domain-property verification in Google Search Console still uses DNS TXT.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional Cloudflare Web Analytics public site token. Empty keeps tracking off.
# Configure the actual site in Cloudflare before enabling; no DNS migration needed.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Public map services require a single server process / replica.
# At higher traffic, configure a shared rate-limited gateway or your own services.
ROAD_ROUTING_ENABLED=true
ROAD_GEOCODER_URL=https://nominatim.openstreetmap.org/search
ROAD_ROUTER_URL=https://routing.openstreetmap.de/routed-car

# Optional local preview origin; leave empty in production. Only exact HTTP
# origins using localhost, 127.0.0.1 or [::1], with an optional port, are accepted.
# No trailing slash, path, credentials, query or fragment; invalid values are ignored.
ROAD_PREVIEW_ORIGIN=
