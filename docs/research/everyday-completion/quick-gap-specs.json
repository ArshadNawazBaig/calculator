          "yd"
        ],
        "depth": "number >=0",
        "depthUnit": [
          "m",
          "cm",
          "in",
          "ft",
          "yd"
        ],
        "density": "positive if mass output/pricing or mass bag required",
        "densityUnit": [
          "kg/m3",
          "g/cm3",
          "lb/ft3"
        ],
        "waste": "optional0..100%; default0; original explicit allowance, not evidence-required",
        "price": "optional nonnegative number; blank means omit cost",
        "priceBasis": [
          "ft3",
          "yd3",
          "m3",
          "L",
          "lb",
          "short-ton",
          "kg",
          "tonne",
          "bag"
        ],
        "bagSize": "positive when bag pricing",
        "bagUnit": [
          "ft3",
          "L",
          "lb",
          "kg"
        ],
        "currency": "display label only"
      },
      "formulas": [
        "Normalize every bed separately: A=sum(length_i*factor_i*width_i*factor_i); known area converts independently. Circle A=pi*(diameter_m/2)^2.",
        "V=A*depth_m; orderV=V*(1+waste/100); M=orderV*density_kg_m3 if density required.",
        "Bulk-volume cost=orderV/priceVolumeFactor*price; bulk-mass cost=M/priceMassFactor*price.",
        "Volume bags=ceil(orderV/(bagSize*volumeFactor)); mass bags=ceil(M/(bagSize*massFactor)); whole-bag cost=bags*price. Do not ceil individual bed bags; aggregate material first.",
        "For bag pricing show unrounded equivalent bags plus whole bags and material surplus so users see rounding policy. Use Decimal for exact integer boundaries."
      ],
      "observedMulchBagPresets": [
        {
          "bagSize": 2,
          "bagUnit": "ft3"
        },
        {
          "bagSize": 76.9,
          "bagUnit": "ft3"
        },
        {
          "bagSize": 60,
          "bagUnit": "L"
        },
        {
          "bagSize": 730,
          "bagUnit": "L"
        }
      ],
      "outputs": [
        "Area m2/ft2",
        "Geometric volume m3/yd3/ft3/L",
        "Order volume after allowance",
        "Mass kg/lb if density supplied",
        "Equivalent bags and order bags when chosen",
        "Material cost excluding delivery/tax/labor"
      ],
      "validation": [
        "Hidden density not required for volume-only mulch. Each row numeric cell must be a string/number, not null/boolean/nested object.",
        "No silent unknown-unit fallback; no negative dimensions/density/price; zero area gives zero material/bags/cost.",
        "Each rectangle contributes its nonoverlapping area; overlap subtraction is not inferred.",
        "Do not apply inferred gravel preset densities as exact facts. Keep editable density and name moisture/compaction assumptions."
      ],
      "sources": [
        "nist"
      ]
    },
