    {
      "id": "wind-units",
      "slugs": [
        "wind-chill-calculator"
      ],
      "proposedAlgorithm": "wind-units",
      "proposedMode": "measurement-units",
      "fields": {
        "temperature": "finite",
        "temperatureUnit": [
          "F",
          "C",
          "K"
        ],
        "wind": "positive",
        "windUnit": [
          "mph",
          "km/h",
          "m/s",
          "knots"
        ],
        "outputTemperatureUnit": [
          "F",
          "C",
          "K"
        ]
      },
      "formulas": [
        "TF = T forF;1.8*T+32 forC;1.8*(T-273.15)+32 forK.",
        "Vmph = V for mph;V/1.609344 forkm/h;V/0.44704 form/s;V*1852/1609.344 forknots.",
        "WCF=35.74+.6215*TF-35.75*Vmph^.16+.4275*TF*Vmph^.16; WCC=(WCF-32)*5/9; WCK=WCC+273.15."
      ],
      "bounds": [
        "Evaluate after normalization: TF<=50 and Vmph>3; strict equality3mph fails. No validity claim for lower-temperature limit beyond source; retain any app finite range only as UI bound.",
        "Kelvin>=0; valid speed above threshold; use tolerant conversion checks at exact physical threshold to avoid1ulp turning3mph equivalent intovalid.",
        "Output is apparent thermal index, not an object temperature, forecast, or precise frostbite timer."
      ],
      "sources": [
        "nws",
        "nwsEquation",
        "nist"
      ]
    },
    {
      "id": "ohm-units",
      "slugs": [
        "ohms-law-calculator"
      ],
      "proposedAlgorithm": "ohm-units",
      "proposedMode": "measurement-units",
      "fields": {
        "pair": [
          "vi",
          "vr",
          "ir",
          "vp",
          "ip",
          "rp"
        ],
        "a": "first known value",
        "aUnit": "options determined by first symbol",
        "b": "second known value",
        "bUnit": "options determined by second symbol",
        "outputVoltageUnit": [
          "kV",
          "V",
          "mV"
        ],
        "outputCurrentUnit": [
          "A",
          "mA"
        ],
        "outputResistanceUnit": [
