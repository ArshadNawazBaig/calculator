  "algorithm": [
    "line16a=max(0,preliminaryDependentCredit\u2212nonrefundableDependentCredit)",
    "line16b=1700*qualifyingChildren",
    "line17=min(line16a,line16b)",
    "line20=.15*max(0,ACTCEarnedIncome\u22122500)",
    "line21=verifiedAdjustedPayrollTaxesLine21",
    "line22=deductibleHalfBaseSE+verifiedUnreportedPayrollTaxesLine22",
    "line23=line21+line22",
    "line24=actualEITC+excessSocialSecurityCredit",
    "line25=max(0,line23\u2212line24)",
    "For ordinary non-PuertoRico scope: ACTC=min(line17,qualifyingChildren>=3?max(line20,line25):line20)"
  ],
  "lineMappings": {
    "line21": "W2Box4+W2Box6+Form8959line7\u2212Form8959line22+0.5*Form8959line13, plus adjusted RRTA components when eligible. A single verified adjusted line21 amount is the safest bounded input; do not collect W2documents or identifiers.",
    "line22": "Schedule1line15 deductible half of regularSE tax + Schedule2line5 unreported socialsecurity/Medicare on tips + Schedule2line6 uncollected socialsecurity/Medicare on wages + Schedule2line13 uncollected socialsecurity/Medicare orRRTA on tips/grouptermlife fromW2box12.",
    "line24": "1040line27a EIC plus Schedule3line11 excessSS/tier1RRTA withheld; EIC is not an income tax withholding amount.",
    "earnedIncome": "Follow IRS earned-income chart. Basic wages+businessProfit\u2212halfSE is usable only within existing regular nonfarm/common scope. Excluded treatyincome, optionalSE methods, combatpay/clergy require a separately verified earned amount."
  },
  "integration": [
    "Increase qualifyingChildren ceiling to a reasonable integer bound; arbitrary2 cap is not a tax rule.",
    "Compute EITC before payroll alternative. Do not accidentally subtract refundable AOTC or the full bundle of other verified refundable credits as EIC.",
    "If EITC remains a continuous estimate, label the combined ACTC calculation as an estimate or accept a separately verified actualEITC for this interaction. Neither zero omission nor double-subtracting EIC is correct.",
    "For computed common payroll input, keep spouseSS caps separate. Adjust AdditionalMedicare withholding to actual wage liability and add half SE AdditionalMedicare. Existing composed persons already distinguish ssWages and medicareWages; use them.",
    "For an independently verified payroll amount, accept only nonnegative finite amount and explain included taxes. Do not add computed taxes again.",
    "NonrefundableDependentCredit must not exceed preliminaryDependentCredit. No ACTC without qualifying child. FilingForm2555 disqualifies ACTC and should be excluded by eligibility gate, including cases where no computed2555mode exists.",
    "Keep PuertoRico resident exception and RRTA as explicit separate verified-input scope unless fully modeled. No need to invent their support to implement the captured three-plus dependent count.",
    "CreditLimitWorksheetB coordination with mortgageinterest/adoption/residentialcleanenergy/DCfirsthomebuyer credits remains separately verified, not implicitly covered by a generic preCTCcredit total."
  ],
