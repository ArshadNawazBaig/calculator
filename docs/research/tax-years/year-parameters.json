  "integrationContracts": [
    {
      "target": "federalComposition / expandedStandard / gainTax / itemizedDeduction / careCredit / traditionalIra / studentLoanInterest / qbi / eitcContinuousEstimate",
      "change": "Validate taxYear in {2025,2026}; select one parameter object once and thread that year into every helper. Retain default2026 for backward compatibility."
    },
    {
      "target": "tax-modules",
      "change": "bracketTax and standardDeduction already support2025. gainTax currently hardcodes2026; self-employment uses184500; child branch caps children2. Any standalone mode newly exposing year must actually propagate it."
    },
    {
      "target": "itemizedDeduction",
      "change": "2025 charity floor0 and section68 reduction0. Do not let2025 nonitemizer donation silently reduce income. Existing cash<=60%-AGI-only simplification stays explicit."
    },
    {
      "target": "qbi",
      "change": "2025 thresholds/ranges differ, no$400 minimum.2026 joint QBI threshold403500 intentionally differs from ordinary24% bracket boundary403550; do not derive it from ordinary brackets."
    },
    {
      "target": "gainTax",
      "change": "2025 MFS15%-band top is300000, not half of MFJ600050. Use explicit table."
    },
    {
      "target": "EITC",
      "change": "Keep continuous-estimate label; published max/rates are rounded so continuous formula can differ from actual IRS $50 income-bin EIC table. Separate actual verified EIC used by ACTC payroll alternative from a planning estimate, or label combined result estimate."
    },
    {
      "target": "QSS",
      "change": "Do not alias QSS to joint globally. QSS uses joint ordinary/gains/basic deduction and IRA-covered phaseout, but other-filer QBI/EITC/tips/OT/car/senior/CTC/AddMedicare thresholds, unless specific statutory rule says otherwise."
    },
    {
      "target": "paycheckComposition",
      "change": "Keep2026 W-4 withholding mode explicitly2026 unless importing actual2025 Pub15-T tables. Captured tax-calculator2025 toggle does not require changing independent2026 payroll mode."
    }
  ],
