{
  "name": "finflo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:sites": "node scripts/build-sites.mjs",
    "preview:worker": "wrangler dev --config wrangler.staged.json --port 3101",
    "coverage:manifest": "node scripts/export-coverage.mjs",
    "i18n:check": "node scripts/check-translations.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:search": "node scripts/analyze-search-console.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:performance": "node scripts/lab-performance.mjs",
    "audit:sources": "node scripts/audit-sources.mjs",
    "audit:field": "node scripts/audit-field-performance.mjs",
    "research:search": "node scripts/build-search-map.mjs",
    "audit:value": "node scripts/audit-page-value.mjs",
    "audit:value:rendered": "node scripts/audit-page-value-rendered.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-super-admin.ts",
    "admin:password": "node --env-file-if-exists=.env.local --import tsx scripts/reset-super-admin-password.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@tiptap/extension-heading": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "better-auth": "^1.7.18",
    "buffer": "^6.0.3",
    "decimal.js": "^10.6.0",
    "encoding-japanese": "^2.4.0",
    "iconv-lite": "^0.7.3",
    "lucide-react": "1.54.0",
    "mathjs": "^15.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-aria": "3.53.0",
    "react-aria-components": "1.22.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "railway": "3.13.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
